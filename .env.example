# Base URL of the shopi-social-commerce-api server (no trailing slash).
# GraphQL endpoint is derived as $NEXT_PUBLIC_API_URL/graphql
NEXT_PUBLIC_API_URL=http://localhost:4000

# Customer-facing Shopi web app (no trailing slash). Every admin link to the
# site uses it: Posts -> View on Shopi, Users -> Impersonate, Social proof.
# Set it on Vercel per environment, e.g. https://www.shopi.co.ke for
# production, then redeploy: NEXT_PUBLIC_ values are baked in at build time.
NEXT_PUBLIC_SHOPI_WEB_URL=http://localhost:3000
